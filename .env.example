# Copiez en .env. Ce fichier est chargé uniquement pour les questions (ask, baseline, web).
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Modèle au format LiteLLM pour un endpoint compatible OpenAI : explore les concepts et répond.
DEMO_CHAT_MODEL=openai/gemma4:31b-cloud
# Facultatif : l'indexation OKF n'appelle aucun LLM ; vide = DEMO_CHAT_MODEL.
DEMO_INDEX_MODEL=
# DEMO_MODEL reste un repli commun si un des deux réglages ci-dessus est vide.
# Facultatif : votre propre bundle OKF et ses questions (chemins absolus ou relatifs au projet).
# DEMO_BUNDLE=bundle
# DEMO_QUESTIONS=questions.json
# Facultatif : figer l'instant utilisé pour la fraîcheur (stale_after), en ISO 8601 avec fuseau.
# DEMO_NOW=2026-11-11T12:00:00Z
