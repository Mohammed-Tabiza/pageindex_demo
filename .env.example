# Copiez en .env. Ce fichier est chargé uniquement pour le mode réel.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Modèles au format LiteLLM pour un endpoint compatible OpenAI.
DEMO_INDEX_MODEL=openai/gemma4:e4b
DEMO_CHAT_MODEL=openai/gemma4:31b-cloud
# DEMO_MODEL reste un repli commun si un des deux réglages ci-dessus est vide.
